{
  "motor": "Google Cloud Firestore (NoSQL, modo nativo)",
  "asignatura": "Integraci\u00f3n de Competencias II (IEI-094)",
  "normalizacion": ["1FN", "2FN", "3FN"],
  "desnormalizacion_nota": "El campo 'correo' se replica en marcaciones y login_log solo para evitar segundas consultas en reportes; siempre refiere al mismo valor de 'usuarios'.",
  "colecciones": [
    {
      "nombre": "usuarios",
      "pk": "usuario",
      "registros": 25,
      "atributos": [
        {"campo": "usuario", "tipo": "string", "pk": true},
        {"campo": "correo", "tipo": "string", "unico": true},
        {"campo": "clave", "tipo": "string"},
        {"campo": "rol", "tipo": "string", "valores": ["administrador", "trabajador"]},
        {"campo": "nombre", "tipo": "string"}
      ]
    },
    {
      "nombre": "marcaciones",
      "pk": "<usuario>_<fecha>_<tipo>",
      "registros": 609,
      "atributos": [
        {"campo": "usuario", "tipo": "string", "fk": "usuarios.usuario"},
        {"campo": "correo", "tipo": "string", "desnormalizado_de": "usuarios.correo"},
        {"campo": "tipo", "tipo": "string", "valores": ["entrada", "salida"]},
        {"campo": "fecha", "tipo": "string", "formato": "YYYY-MM-DD"},
        {"campo": "hora", "tipo": "string", "formato": "HH:MM:SS"},
        {"campo": "atrasado", "tipo": "bool"},
        {"campo": "salida_anticipada", "tipo": "bool"},
        {"campo": "timestamp", "tipo": "datetime"}
      ]
    },
    {
      "nombre": "alertas",
      "pk": "alerta_<tipo>_<usuario>_<fecha>",
      "registros": 58,
      "atributos": [
        {"campo": "tipo", "tipo": "string", "valores": ["atraso", "salida_anticipada", "inasistencia"]},
        {"campo": "usuario", "tipo": "string", "fk": "usuarios.usuario"},
        {"campo": "fecha", "tipo": "string", "formato": "YYYY-MM-DD"},
        {"campo": "hora", "tipo": "string", "formato": "HH:MM:SS"},
        {"campo": "estado", "tipo": "string", "valores": ["pendiente", "leida"]},
        {"campo": "timestamp", "tipo": "datetime"}
      ]
    },
    {
      "nombre": "login_log",
      "pk": "<usuario>_<fecha>_<n>",
      "registros": 74,
      "atributos": [
        {"campo": "usuario", "tipo": "string", "fk": "usuarios.usuario"},
        {"campo": "correo", "tipo": "string", "desnormalizado_de": "usuarios.correo"},
        {"campo": "fecha", "tipo": "string", "formato": "YYYY-MM-DD"},
        {"campo": "hora", "tipo": "string", "formato": "HH:MM:SS"},
        {"campo": "resultado", "tipo": "string", "valores": ["exitoso", "fallido"]}
      ]
    },
    {
      "nombre": "config",
      "pk": "empresa",
      "registros": 1,
      "atributos": [
        {"campo": "nombre", "tipo": "string"},
        {"campo": "hora_entrada", "tipo": "string", "formato": "09:30:00"},
        {"campo": "hora_salida", "tipo": "string", "formato": "17:30:00"}
      ]
    }
  ],
  "relaciones": [
    "marcaciones.usuario -> usuarios.usuario",
    "alertas.usuario -> usuarios.usuario",
    "login_log.usuario -> usuarios.usuario"
  ],
  "feriados_excluidos": ["2026-09-17", "2026-09-18"],
